# Copy to .env (never commit .env). Values here are for local development only.
DEBUG=1
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4801,http://localhost:4801
# Only when the web client is served from another origin:
CORS_ALLOWED_ORIGINS=
# Explicit WebSocket origins (default: derived from ALLOWED_HOSTS)
WEBSOCKET_ALLOWED_ORIGINS=
WEB_APP_URL=/

# SQLite by default; set DB_ENGINE=django.db.backends.postgresql for Postgres.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# Number of trusted reverse proxies in front of the app (1 on most PaaS). Used to read the
# client IP for rate limits; 0 ignores X-Forwarded-For (which clients can forge).
TRUSTED_PROXY_COUNT=0

# Enables the Redis cache, channel layer and multi-process presence.
REDIS_URL=

# Development-only login with any phone number and this code (always off when DEBUG=0).
DEMO_AUTH_ENABLED=1
DEMO_AUTH_CODE=1234

# Chat package
CHAT_ENABLE_GROUPS=1
CHAT_ENABLE_ATTACHMENTS=1
CHAT_MAX_ATTACHMENT_SIZE=10485760

# Optional social login
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=
