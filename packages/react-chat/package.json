{
  "name": "@realtime-chat/react",
  "version": "0.1.0",
  "description": "Accessible, themeable React components and an embeddable widget for django-realtime-chat.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@realtime-chat/client": "^0.1.0",
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.3.1",
    "emojibase-data": "^16.0.3",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@realtime-chat/client": "0.1.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  }
}
